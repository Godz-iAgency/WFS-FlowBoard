# Browser-safe Supabase credentials (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Optional: code used to select the initial warehouse record.
NEXT_PUBLIC_WAREHOUSE_CODE=WFS-01

# Server-only Gemini credentials. Never prefix this key with NEXT_PUBLIC_.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Optional stable model override.
GEMINI_MODEL=gemini-3.7-flash
